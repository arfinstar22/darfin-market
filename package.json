{
  "name": "darfin-market",
  "version": "1.0.0",
  "description": "DARFIN MARKET — Telegram Bot for Crypto (INDODAX, CoinPaprika), FX (Frankfurter), and Stocks (IDX & Global via Finnhub, Twelve Data, Alpha Vantage)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:bot": "tsx watch src/app.ts",
    "dev:webapp": "tsx watch src/webapp/standalone.ts",
    "dev:worker": "tsx watch src/workers/worker.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/webapp/public','dist/webapp/public',{recursive:true});fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true});\"",
    "typecheck": "tsc --noEmit",
    "start:bot": "node dist/app.js",
    "start:webapp": "node dist/webapp/standalone.js",
    "start:worker": "node dist/workers/worker.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "bullmq": "^5.35.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.0",
    "grammy": "^1.35.0",
    "ioredis": "^5.5.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
