# Application
NODE_ENV=development
APP_NAME=DARFIN MARKET
APP_TIMEZONE=Asia/Makassar
LOG_LEVEL=info

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ADMIN_IDS=123456789

# Telegram Mini App (WebApp)
# On Render.com, PORT and RENDER_EXTERNAL_URL are injected automatically.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=3000
WEBAPP_URL=

# Set true on Render.com to run Bot + Mini App + Alert/Snapshot Worker in 1 service
RUN_EMBEDDED_WORKER=false

# Database (supports Neon, Supabase, Render Postgres SSL automatically)
DATABASE_URL=postgresql://darfin:change_me@postgres:5432/darfin_market

# Redis (optional on single-instance Render; supports redis:// and TLS rediss:// e.g. Upstash)
REDIS_URL=redis://redis:6379

# Crypto & FX Provider URLs (No API key required)
INDODAX_BASE_URL=https://indodax.com
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# Stock Market Providers (Official APIs — optional, enable as keys are provided)
# Finnhub (US real-time stocks, free 60 req/min): https://finnhub.io/register
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_API_KEY=

# Twelve Data (IDX Indonesia & Global stocks, free 800 req/day): https://twelvedata.com/pricing
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_API_KEY=

# Alpha Vantage (Optional fallback global stocks, free 25 req/day EOD): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# Cache TTL (seconds)
INDODAX_TICKER_TTL=20
INDODAX_PAIRS_TTL=21600
COINPAPRIKA_TICKER_TTL=600
FRANKFURTER_RATE_TTL=21600
STOCK_US_QUOTE_TTL=15
STOCK_GLOBAL_QUOTE_TTL=60

# Worker settings
INDODAX_ALERT_INTERVAL_SECONDS=60
COINPAPRIKA_ALERT_INTERVAL_SECONDS=600
STOCK_ALERT_INTERVAL_SECONDS=120
SNAPSHOT_INTERVAL_SECONDS=300
SNAPSHOT_RETENTION_DAYS=60

# Provider Quota limits
COINPAPRIKA_MONTHLY_QUOTA=20000
TWELVE_DATA_DAILY_QUOTA=800
ALPHA_VANTAGE_DAILY_QUOTA=25

# Limits
MAX_WATCHLIST_ITEMS=20
MAX_ACTIVE_ALERTS_PER_USER=20
USER_COMMANDS_PER_MINUTE=20
PROVIDER_HTTP_TIMEOUT_MS=8000
